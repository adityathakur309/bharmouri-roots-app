# Copy to .env and fill in real values. Never commit secrets.

NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@HOST/DB
JWT_SECRET=replace-with-long-random-string-min-32-chars

# Canonical public site URL (used for SEO canonicals, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://bharmouriroots.com
SITE_URL=https://bharmouriroots.com

# Image upload storage: auto — disk on VPS/local, MongoDB on Vercel
# Force with: disk | mongodb
# UPLOAD_STORAGE=mongodb

# Optional legacy aliases
NEXTAUTH_URL=https://bharmouriroots.com
NEXTAUTH_SECRET=

# Payments — production is fail-closed without real keys
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
PAYMENT_MOCK_MODE=false

# Shipping estimates (booking stays mocked until go-live unlock)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=176315
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPPING_PROVIDER=shiprocket
SHIPPING_MOCK_MODE=false

# Admin bootstrap (seed / register)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Email (Gmail SMTP example)
# Use an App Password (16 chars). Spaces are OK — the app strips them.
# EMAIL_FROM should use the same Gmail as SMTP_USER (Gmail rejects mismatched From).
EMAIL_PROVIDER=smtp
EMAIL_FROM="Bharmouri Roots <yourgmail@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Search Console / Bing (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_API_URL=/api
