# Copy to .env and fill in real values. Never commit secrets.

NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@HOST/DB
JWT_SECRET=replace-with-long-random-string-min-32-chars

# Canonical public site URL (SEO: sitemap, robots, OG, emails)
# MUST be your live domain on Vercel/production — never http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://bharmouriroots.com
SITE_URL=https://bharmouriroots.com

# Image upload storage: auto — disk on VPS/local, MongoDB on Vercel
# Force with: disk | mongodb
# UPLOAD_STORAGE=mongodb

# Optional legacy aliases
NEXTAUTH_URL=https://bharmouriroots.com
NEXTAUTH_SECRET=

# Google OAuth (optional — enables Continue with Google on login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments — production is fail-closed without real keys
# Never put RAZORPAY_KEY_SECRET or WEBHOOK_SECRET in NEXT_PUBLIC_* vars
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
PAYMENT_MOCK_MODE=false

# Refunds — mock by default in dev; live Razorpay test refunds when REFUND_MOCK_MODE=false + keys set
REFUND_MOCK_MODE=true
# REFUND_MOCK_OUTCOME=success | failed | pending (demo/testing)
# REFUND_MOCK_OUTCOME=success
REFUND_WINDOW_DAYS=7
# In production defaults to true — returns only after delivery within window
REFUND_REQUIRE_DELIVERY=false

# Seed — hard-delete inactive products not on any order line (safe cleanup)
SEED_PURGE_INACTIVE_PRODUCTS=true

# Shipping — mock true keeps estimates + booking fake; false uses live Shiprocket
# SHIPROCKET_MOCK is an alias of SHIPPING_MOCK_MODE
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=176315
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional return/warehouse destination for reverse pickups
# SHIPROCKET_RETURN_ADDRESS=
# SHIPROCKET_RETURN_CITY=Bharmour
# SHIPROCKET_RETURN_STATE=Himachal Pradesh
# SHIPROCKET_RETURN_PHONE=
# SHIPROCKET_RETURN_EMAIL=
SHIPPING_PROVIDER=shiprocket
SHIPPING_BOOKING_PROVIDER=shiprocket
SHIPPING_MOCK_MODE=true
SHIPROCKET_MOCK=true

# Admin bootstrap (seed / register)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Email (Gmail SMTP example)
# Use an App Password (16 chars). Spaces are OK — the app strips them.
# EMAIL_FROM should use the same Gmail as SMTP_USER (Gmail rejects mismatched From).
EMAIL_PROVIDER=smtp
EMAIL_FROM="Bharmouri Roots <yourgmail@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Search Console / Bing (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_API_URL=/api
